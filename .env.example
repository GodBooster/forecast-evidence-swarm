# Forecast Evidence Swarm: live LLM analyst configuration (template, no values).
# Copy to a local file that git ignores, e.g. `.env.local`, fill it in yourself
# and pass it with `--env-file .env.local`. Never commit keys or paste them in chat.
#
# Provider kind: anthropic | openai_compatible
#   openai_compatible covers NEAR AI Cloud and other gateways that expose
#   POST {base}/chat/completions with a bearer key.
FORECAST_LLM_PROVIDER=
# Exact model name accepted by that provider.
FORECAST_LLM_MODEL=
# Secret. Set locally only.
FORECAST_LLM_API_KEY=
# Required for openai_compatible (e.g. the provider's documented /v1 base URL).
# Optional for anthropic (default https://api.anthropic.com).
FORECAST_LLM_BASE_URL=
# Optional, anthropic only: low | medium | high | xhigh | max
FORECAST_LLM_ANTHROPIC_EFFORT=
# Operator-supplied prices used for cost estimates and budget checks.
# Integer nano-USD per token: 1000 means $1.00 per million tokens.
# Check the provider's current price list; these are not looked up automatically.
FORECAST_LLM_INPUT_NANO_USD_PER_TOKEN=
FORECAST_LLM_OUTPUT_NANO_USD_PER_TOKEN=
